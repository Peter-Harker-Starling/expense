@model IEnumerable<expense.Models.ExpenseRecord>

@{
    ViewData["Title"] = "Record";
    var emptyMessageStyle = Model.Any() ? "display:none;" : "";
}

<div class="record-page">
    <div class="page-actions">
        <h2>Expense</h2>
        <form asp-controller="Home" asp-action="Index" method="get">
            <input type="month" name="month" value="@ViewBag.SelectedMonth" class="form-control" onchange="this.form.submit()" />
        </form>
    </div>

    <div class="view-toggle">
        <button type="button" id="btnList" class="toggle-btn active" onclick="showList()">Expense</button>
        <button type="button" id="btnCategory" class="toggle-btn" onclick="showCategory()">Category</button>
    </div>

    <div id="recordList" class="record-list">
        <p id="emptyMessage" class="text-center text-muted" style="@emptyMessageStyle">Currently no expense records.</p>

        @foreach (var m in Model)
        {
            <div class="record" id="record-@m.Id">
                <div class="record-info">
                    <div class="record-item">@m.Item</div>
                    <div class="record-meta">
                        <div class="record-date">@m.Date.ToString("yyyy-MM-dd")</div>
                        <div class="record-category">@m.Category</div>
                    </div>
                </div>
                <div class="record-actions">
                    <div class="record-amount">💰@m.Amount</div>
                    <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-warning btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('ready to delete?');">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div id="categoryList" class="record-list" style="display: none;">
        @foreach (var c in (Dictionary<string, decimal>)ViewBag.CategoryTotals)
        {
            <div class="record">
                <div class="record-item">@c.Key</div>
                <div class="record-amount">💰@c.Value</div>
            </div>
        }
    </div>

    <div class="page-total">
        <strong><span class="page-total-amount">💰Total : @ViewBag.TotalAmount</span></strong>
        <a asp-controller="ExpenseRecord" asp-action="Create" class="fab" aria-label="Create">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M12 5v14M5 12h14" />
            </svg>
        </a>
    </div>
</div>
    
<script>
    function showList() {
        document.getElementById('recordList').style.display = '';
        document.getElementById('categoryList').style.display = 'none';
        document.getElementById('btnList').classList.add('active');
        document.getElementById('btnCategory').classList.remove('active');
    }

    function showCategory() {
        document.getElementById('recordList').style.display = 'none';
        document.getElementById('categoryList').style.display = '';
        document.getElementById('btnList').classList.remove('active');
        document.getElementById('btnCategory').classList.add('active');
    }
</script>