@model IEnumerable<expense.Models.ExpenseRecord>

@{
    ViewData["Title"] = "紀錄";
    var emptyMessageStyle = Model.Any() ? "display:none;" : "";
}

<div class="record-page">
    <div class="page-actions">
        <h2>紀錄</h2>
        <form asp-controller="Home" asp-action="Index" method="get">
            <input type="month" name="month" value="@ViewBag.SelectedMonth" class="form-control" onchange="this.form.submit()" />
        </form>
    </div>

    <div class="view-toggle">
        <button type="button" id="btnList" class="toggle-btn active" onclick="showList()">明細</button>
        <button type="button" id="btnCategory" class="toggle-btn" onclick="showCategory()">分類</button>
    </div>

    <div id="recordList" class="record-list">
        <p id="emptyMessage" class="text-center text-muted" style="@emptyMessageStyle">目前還沒有紀錄。</p>

        @foreach (var m in Model)
        {
            <div class="record" id="record-@m.Id">
                <div class="record-info">
                    <div class="record-item">@m.Item</div>
                    <div class="record-meta">
                        <div class="record-date">@m.Date.ToString("yyyy-MM-dd")</div>
                        <div class="record-category">@m.Category</div>
                    </div>
                </div>
                <div class="record-actions">
                    <div class="record-amount">💰@m.Amount</div>
                    <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-warning btn-sm">編輯</a>
                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('確定要移除?');">移除</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div id="categoryList" class="record-list" style="display: none;">
        @foreach (var c in (Dictionary<string, decimal>)ViewBag.CategoryTotals)
        {
            <div class="record">
                <div class="record-item">@c.Key</div>
                <div class="record-amount">💰@c.Value</div>
            </div>
        }
    </div>

    <div class="page-total">
        <strong><span class="page-total-amount">💰Total : @ViewBag.TotalAmount</span></strong>
        <a asp-controller="ExpenseRecord" asp-action="Create" class="fab" aria-label="Create">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M12 5v14M5 12h14" />
            </svg>
        </a>
    </div>
</div>
    
<script>
    function showList() {
        document.getElementById('recordList').style.display = '';
        document.getElementById('categoryList').style.display = 'none';
        document.getElementById('btnList').classList.add('active');
        document.getElementById('btnCategory').classList.remove('active');
    }

    function showCategory() {
        document.getElementById('recordList').style.display = 'none';
        document.getElementById('categoryList').style.display = '';
        document.getElementById('btnList').classList.remove('active');
        document.getElementById('btnCategory').classList.add('active');
    }
</script>

<style>
    .record-page {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .page-actions {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .page-actions input {
            border-radius: 10px;
        }

    .view-toggle {
        display: flex;
        padding: 4px;
        margin-bottom: 10px;
        background: white;
        border-radius: 10px;
    }

    .toggle-btn {
        flex: 1;
        padding: 8px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: gray;
        font-weight: 600;
        cursor: pointer;
    }

        .toggle-btn.active {
            background: #198754;
            color: white;
        }

    .record-list {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .record {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        background: white;
        border-radius: 10px;
    }

    .record-item {
        font-weight: bold;
    }

    .record-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
    }

    .record-category {
        font-size: 0.875rem;
        padding: 2px 10px;
        border-radius: 999px;
        background: #e8f5ee;
        color: #198754;
        font-weight: 500;
    }

    .record-date {
        font-size: 0.875rem;
        color: gray;
    }

    .record-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .record-amount {
        font-weight: bold;
        margin-right: 8px;
    }

    .page-total {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-top: 20px;
        padding: 20px;
        background-color: white;
        border-radius: 10px;
    }

    .page-total-amount {
        font-size: 1.5rem;
    }

    .fab {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #198754;
        color: white;
        text-decoration: none;
    }

        .fab:hover {
            color: white;
            background-color: #157347;
        }
</style>