@model expense.Models.ExpenseRecord

@{
    ViewData["Title"] = "新增";
}

<h2>新增</h2>

<div class="text-center">
    <form id="uploadForm" asp-action="Analyze" method="post" class="create-page-actions">
        <input type="text" name="input" placeholder="可以輸入 (例：便當100)" class="form-control" />
        <button id="uploadBtn" type="submit" class="btn btn-primary">解析</button>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-alert">
            <div class="error-alert-title">⚠️ 解析失敗</div>
            <div class="error-alert-message">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        </div>
    }

    <form asp-action="Save" method="post" class="create-card">
        <div>
            <label>品名</label>
            <input type="text" name="Item" class="form-control" value="@(Model?.Item ?? "")" />
        </div>
        <div>
            <label>日期</label>
            <input type="date" name="Date" class="form-control" value="@(Model?.Date.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        <div>
            <label>金額</label>
            <input type="number" name="Amount" class="form-control" value="@(Model?.Amount.ToString() ?? "")" />
        </div>
        <div>
            <label>分類</label>
            <select name="Category" class="form-control">
                <option value="">選擇分類</option>
                <option value="餐飲" selected="@(Model?.Category == "餐飲")">餐飲</option>
                <option value="交通" selected="@(Model?.Category == "交通")">交通</option>
                <option value="娛樂" selected="@(Model?.Category == "娛樂")">娛樂</option>
                <option value="生活" selected="@(Model?.Category == "生活")">生活</option>    
            </select>
        </div>
      
        <button type="submit" class="btn btn-success">儲存</button>
        <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "Home")'">取消</button>
    </form>

</div>

<script>
    document.getElementById('uploadForm').addEventListener('submit', function() {
        const btn = document.getElementById('uploadBtn'); 
        btn.innerText = '解析中...';
        btn.disabled = true;
    });
</script>

<style>
    .create-page-actions {
        margin-bottom: 20px;
        display: flex;
        gap: 10px;
    }

    .create-page-actions input {
        border-radius: 10px;
    }

    .create-page-actions .btn {
        border-radius: 10px;
        width: 100px;
    }

    .create-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        text-align: left;
    }

        .create-card div {
            margin-bottom: 14px;
        }

        .create-card label {
            font-weight: 600;
            font-size: 0.9rem;
        }

    /* 錯誤訊息 */
    .error-alert {
        margin: 20px;
        padding: 16px;
        border-radius: 10px;
        background-color: #f8d7da;
        color: #842029;
    }

    .error-alert-title {
        font-weight: 600;
        font-size: 17px;
    }

    .error-alert-message {
        font-size: 14px;
        line-height: 1.6;
    }
</style>